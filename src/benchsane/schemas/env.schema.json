{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/RyanJHamby/benchsane/schemas/env.schema.json",
 "title": "benchsane environment manifest",
 "type": "object",
 "required": [
  "schema",
  "tool",
  "captured_at",
  "os",
  "cpu",
  "toolchains",
  "env",
  "checks",
  "grade"
 ],
 "properties": {
  "schema": {
   "const": "benchsane.env/v1"
  },
  "tool": {
   "type": "string"
  },
  "captured_at": {
   "type": "string",
   "format": "date-time"
  },
  "os": {
   "type": "object"
  },
  "cpu": {
   "type": "object"
  },
  "memory_gib": {
   "type": [
    "number",
    "null"
   ]
  },
  "machine": {
   "type": "object"
  },
  "gpu": {
   "type": [
    "string",
    "null"
   ]
  },
  "toolchains": {
   "type": "object"
  },
  "env": {
   "type": "object"
  },
  "git": {
   "type": [
    "object",
    "null"
   ]
  },
  "checks": {
   "type": "array"
  },
  "grade": {
   "enum": [
    "clean",
    "caveated",
    "smoke"
   ]
  }
 }
}
